#!/usr/bin/env bash
#
# op-test - run RSpec inside the OpenProject backend-test container against
# whatever git worktree you're currently in.
set -euo pipefail

PROG="${0##*/}"
CONTAINER_ROOT="${OP_CONTAINER_ROOT:-/home/dev/openproject}"
SERVICE="${OP_TEST_SERVICE:-backend-test}"
read -r -a RSPEC <<<"${OP_RSPEC:-bundle exec rspec}"

usage() {
  cat <<EOF
$PROG - run RSpec in the OpenProject backend-test container from any worktree.

Derives the container working directory from your current git worktree, and
temporarily matches the worktree's .ruby-version to the main checkout so a
linked worktree on another branch still boots against the shared image.

USAGE:
  $PROG <spec>...            run one or more spec files or file:line targets
  $PROG <spec> -- <args>     pass everything after -- straight to rspec
  $PROG -h | --help          show this help

EXAMPLES:
  $PROG spec/models/user_spec.rb
  $PROG spec/requests/foo_spec.rb:42 spec/models/bar_spec.rb
  $PROG spec/foo_spec.rb -- --seed 1234

ENVIRONMENT:
  OP_CONTAINER_ROOT   mount target in the container (default $CONTAINER_ROOT)
  OP_TEST_SERVICE     compose service           (default $SERVICE)
  OP_RSPEC            test runner               (default "bundle exec rspec")
EOF
}

case "${1:-}" in
  ""|-h|--help) usage; exit 0 ;;
esac

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "$PROG: not inside a git worktree" >&2
  exit 1
fi

# Main checkout = docker mount source = parent of the shared git dir.
main_root="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
worktree_top="$(git rev-parse --show-toplevel)"

# Container working dir mirrors the worktree's position under the mount.
rel="${worktree_top#"$main_root"}"
rel="${rel#/}"
container_wd="$CONTAINER_ROOT${rel:+/$rel}"

# The Gemfile pins Ruby via .ruby-version; a linked worktree on another branch
# may pin a version the image doesn't ship. Match the main checkout for the run.
rv="$worktree_top/.ruby-version"
main_rv="$main_root/.ruby-version"
restore=false
if [[ -f "$rv" && -f "$main_rv" ]] && ! cmp -s "$rv" "$main_rv"; then
  cp "$rv" "$rv.optest-bak"
  cp "$main_rv" "$rv"
  restore=true
fi
cleanup() { if $restore; then mv "$rv.optest-bak" "$rv"; fi; }
trap cleanup EXIT

echo "$PROG: $SERVICE @ $container_wd" >&2
docker compose --project-directory "$main_root" \
  exec -w "$container_wd" "$SERVICE" \
  "${RSPEC[@]}" "$@"
