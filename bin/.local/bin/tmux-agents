#!/usr/bin/env bash
#
# tmux-agents - traffic lights for AI agent panes in the tmux status bar.
#
# Each agent pane carries a @agent_state user option (working, blocked, done,
# idle). Agents set it through their hooks; the status line renders it and the
# jump commands read it. State lives in tmux only: no daemon, no cache files.
set -euo pipefail

PROG="${0##*/}"
VERSION="0.1.0"

usage() {
  cat <<USAGE
$PROG - traffic lights for AI agent panes in the tmux status bar.

USAGE:
  $PROG set <state>     mark the calling pane: working | blocked | done | idle
  $PROG clear           remove the mark from the calling pane
  $PROG sync            reconcile every marked pane against claude agents --json
  $PROG hook            Claude Code hook adapter: reads the hook JSON on stdin
                        and maps the event to a state
  $PROG list            marked panes, blocked first: id, state, target, title
  $PROG jump <pane_id>  switch to that pane, across sessions
  $PROG next            jump to the next blocked pane, else the next done one
  $PROG menu            pick an agent pane from a tmux menu
  $PROG -h | --help     show this help
  $PROG -V | --version  show the version

Wire the hook in ~/.claude/settings.json with "command": "$PROG hook" under
SessionStart, SessionEnd, UserPromptSubmit, PreToolUse, PostToolUse,
PermissionRequest, PermissionDenied, Notification and Stop.

ENVIRONMENT:
  TMUX_AGENTS_LOG           append every hook event and the state it mapped to
  TMUX_AGENTS_CONFIG_DIRS   colon-separated Claude config dirs for sync
                            (default: ~/.claude and every ~/.claude-* with a
                            settings.json)
USAGE
}

die() {
  echo "$PROG: $1" >&2
  exit "${2:-1}"
}

usage_error() {
  echo "$PROG: $1" >&2
  echo "Try '$PROG --help' for more information." >&2
  exit 2
}

refresh_clients() {
  tmux list-clients -F '#{client_name}' 2>/dev/null |
    while IFS= read -r client; do
      tmux refresh-client -S -t "$client" 2>/dev/null || true
    done
}

# Hooks run from a pane the agent may already have left, so a missing pane
# is a no-op rather than an error.
set_state() {
  local state="$1"
  local pane="${2:-${TMUX_PANE:-}}"
  [[ -n "$pane" ]] || return 0
  case "$state" in
    working|blocked|done|idle)
      tmux set -p -t "$pane" @agent_state "$state" 2>/dev/null || return 0 ;;
    clear)
      tmux set -p -t "$pane" -u @agent_state 2>/dev/null || return 0
      tmux set -p -t "$pane" -u @agent_name 2>/dev/null || true ;;
    *) die "unknown state '$state'" ;;
  esac
  refresh_clients
}

current_state() {
  tmux display -p -t "${TMUX_PANE:-}" '#{@agent_state}' 2>/dev/null || true
}

# Pids under a pane's shell, however deep (claude may sit inside nvim).
descendants_of() {
  awk -v root="$1" '
    { parent[$1] = $2 }
    END {
      for (p in parent) {
        q = p
        while (q in parent) { q = parent[q]; if (q == root) { print p; break } }
      }
    }' <<< "$2"
}

# Each Claude account keeps its own agent registry under its config dir.
config_dirs() {
  if [[ -n "${TMUX_AGENTS_CONFIG_DIRS:-}" ]]; then
    tr ':' '\n' <<< "$TMUX_AGENTS_CONFIG_DIRS"
    return
  fi
  local dir
  for dir in "$HOME/.claude" "$HOME"/.claude-*; do
    [[ -f "$dir/settings.json" ]] && echo "$dir"
  done
  return 0
}

# Hooks fire nothing on an Esc interrupt, so a pane stays green while Claude
# sits waiting. Claude reports the truth per pid (busy, waiting, idle); this
# corrects any pane whose light disagrees. A fresh session that has never
# been prompted stays grey rather than being promoted to "your turn".
sync() {
  local panes agents tree changed=0
  panes="$(tmux list-panes -a -f '#{@agent_state}' \
    -F '#{pane_id} #{pane_pid} #{@agent_state}' 2>/dev/null)" || return 0
  [[ -n "$panes" ]] || return 0
  agents="$(for dir in $(config_dirs); do
      CLAUDE_CONFIG_DIR="$dir" claude agents --json 2>/dev/null
    done | jq -r '.[] | select(.status != null) | "\(.pid) \(.status) \(.name // "")"')" || return 0
  [[ -n "$agents" ]] || return 0
  tree="$(ps -axo pid=,ppid=)"

  local pane pane_pid state pid status name want
  while read -r pane pane_pid state; do
    status="" name=""
    for pid in $(descendants_of "$pane_pid" "$tree"); do
      read -r status name < <(awk -v p="$pid" '$1 == p { print $2, $3 }' <<< "$agents") || true
      [[ -n "$status" ]] && break
    done
    if [[ -n "$name" && "$name" != "$(tmux display -p -t "$pane" '#{@agent_name}')" ]]; then
      tmux set -p -t "$pane" @agent_name "$name" 2>/dev/null && changed=1
    fi
    case "$status" in
      busy)    want=working ;;
      waiting) want=blocked ;;
      idle)    [[ "$state" == working || "$state" == blocked ]] && want=done || want="" ;;
      *)       want="" ;;
    esac
    if [[ -n "$want" && "$want" != "$state" ]]; then
      tmux set -p -t "$pane" @agent_state "$want" 2>/dev/null && changed=1
    fi
  done <<< "$panes"

  [[ "$changed" -eq 1 ]] && refresh_clients
  return 0
}

# Tab-separated: pane_id, state, session:window, title. Panes that need you
# come first, then finished ones; ties keep session order so "next" cycles
# predictably.
list() {
  local t=$'\t'
  tmux list-panes -a -f '#{@agent_state}' \
    -F "#{@agent_state}$t#{pane_id}$t#{session_name}:#{window_index}$t#{pane_current_command}$t#{pane_title}" 2>/dev/null |
    awk -F'\t' -v OFS='\t' '
      $4 == "fish" { next }
      { rank = ($1 == "blocked") ? 0 : ($1 == "done") ? 1 : ($1 == "working") ? 2 : 3
        print rank, $2, $1, $3, $5 }' |
    sort -t $'\t' -k1,1n -k4,4 | cut -f2-
}

jump() {
  local pane="$1" session
  session="$(tmux display -p -t "$pane" '#{session_name}' 2>/dev/null)" ||
    die "no such pane '$pane'"
  tmux select-window -t "$pane"
  tmux select-pane -t "$pane"
  tmux switch-client -t "$session"
}

# First blocked pane after the current one, wrapping; failing that, first
# done pane. Nothing to do is reported in the status line, not as an error.
next() {
  local rows current target
  rows="$(list)"
  current="${TMUX_PANE:-}"
  for want in blocked done; do
    target="$(awk -F'\t' -v want="$want" -v cur="$current" '
      $2 == want { ids[n++] = $1 }
      END {
        if (n == 0) exit
        start = 0
        for (i = 0; i < n; i++) if (ids[i] == cur) start = i + 1
        print ids[start % n]
      }' <<< "$rows")"
    [[ -n "$target" ]] && { jump "$target"; return 0; }
  done
  tmux display-message "no agent needs you"
}

menu() {
  local rows args=() keys="123456789abcdefghijklmnopqrstuvwxyz" i=0
  rows="$(list)"
  [[ -n "$rows" ]] || { tmux display-message "no agents running"; return 0; }
  local pane state target title colour
  while IFS=$'\t' read -r pane state target title; do
    case "$state" in
      blocked) colour='#{@thm_red}' ;;
      done)    colour='#{@thm_yellow}' ;;
      working) colour='#{@thm_green}' ;;
      *)       colour='#{@thm_overlay_1}' ;;
    esac
    title="${title:0:48}"
    args+=("#[fg=$colour]●#[default] $target  ${title//#/##}" "${keys:$i:1}" "run-shell '$PROG jump $pane'")
    i=$((i + 1))
  done <<< "$rows"
  tmux display-menu -T "#[align=centre] Agents " -x C -y C "${args[@]}"
}

hook() {
  local payload event ntype state
  payload="$(cat)"
  event="$(printf '%s' "$payload" | jq -r '.hook_event_name // empty')"
  ntype="$(printf '%s' "$payload" | jq -r '.notification_type // empty')"

  case "$event" in
    SessionStart)                              state=idle ;;
    SessionEnd)                                state=clear ;;
    UserPromptSubmit|PostToolUse|PermissionDenied) state=working ;;
    PermissionRequest)                         state=blocked ;;
    # Hooks run async, so PreToolUse can land after the PermissionRequest for
    # the same call; it must not paint over a pending prompt.
    PreToolUse) [[ "$(current_state)" == blocked ]] && state="" || state=working ;;
    Stop)                                      state=done ;;
    Notification)
      case "$ntype" in
        permission_prompt|elicitation_dialog|agent_needs_input) state=blocked ;;
        idle_prompt)                                            state=done ;;
        *)                                                      state="" ;;
      esac ;;
    *) state="" ;;
  esac

  if [[ -n "${TMUX_AGENTS_LOG:-}" ]]; then
    printf '%s %s %s %s -> %s\n' "$(date +%T)" "${TMUX_PANE:-nopane}" \
      "$event" "${ntype:--}" "${state:-ignored}" >> "$TMUX_AGENTS_LOG"
  fi

  [[ -n "$state" ]] && set_state "$state"
  return 0
}

[[ $# -gt 0 ]] || { usage; exit 0; }

case "$1" in
  -h|--help)    usage ;;
  -V|--version) echo "$PROG $VERSION" ;;
  set)          [[ $# -eq 2 ]] || usage_error "'set' takes exactly one state"
                set_state "$2" ;;
  clear)        set_state clear ;;
  hook)         hook ;;
  sync)         sync ;;
  list)         list ;;
  jump)         [[ $# -eq 2 ]] || usage_error "'jump' takes exactly one pane id"
                jump "$2" ;;
  next)         next ;;
  menu)         menu ;;
  -*)           usage_error "unrecognized option '$1'" ;;
  *)            usage_error "unknown command '$1'" ;;
esac
