# Secrets - copy this to secrets.fish and fill in values
# This file is gitignored and auto-sourced by fish on startup
#
# set -x GITHUB_TOKEN "your-token-here"
# set -x LEDGER_FILE ~/path/to/your/ledger.journal
#
# Per-directory Claude Code account routing, used by functions/claude.fish.
# Entries are "project_root=claude_config_dir"; the first match wins, and any
# path that matches nothing falls through to the default ~/.claude.
# set -g claude_account_map "$HOME/work/acme=$HOME/.claude-acme-work"
